+      // PARKHILL PATCH: serve 404 instead of RFC 9728 Protected Resource Metadata.
+      // LibreChat unconditionally copies PRM's `resource` onto the Entra /authorize
+      // request (MCPOAuthHandler: "Added resource parameter"). Entra then evaluates the
+      // Graph scopes against resource "http://localhost:8931/mcp", which is not a
+      // registered application in the tenant, so it cannot match the tenant-wide admin
+      // consent grant and returns AADSTS90095 to every user who cannot self-consent.
+      // LibreChat omits `resource` only when PRM discovery returns nothing; a mismatched
+      // `resource` makes it throw instead, so 404 is the only workable option.
+      // Auth is unaffected: the bearer token is still validated against Graph.
+      const parkhillNoPrm = (_req: Request, res: Response) => {
+        res.status(404).end();
+      };
+      app.get('/.well-known/oauth-protected-resource', parkhillNoPrm);
+      app.get('/.well-known/oauth-protected-resource/*path', parkhillNoPrm);
+      void protectedResourcesHandler;
 
